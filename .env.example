# ==============================================================================
# TEMPLATE KONFIGURASI ENVIRONMENT SILSILAH (.env.example)
# Salin file ini menjadi .env.local:
#   cp .env.example .env.local
# ==============================================================================

# ==============================================================================
# PILIHAN 1: JIKA DIDEPLOY KE CLOUD / HOSTING (Vercel, Supabase, Neon, Railway, Render, VPS)
# Jika menggunakan cloud database, cukup isi DATABASE_URL di bawah ini:
# ==============================================================================
DATABASE_URL=
DATABASE_SSL=true

# ==============================================================================
# PILIHAN 2: JIKA BERJALAN DI LOCALHOST (Komputer Lokal)
# Jika DATABASE_URL di atas kosong, aplikasi otomatis memakai konfigurasi PGHOST di bawah:
# ==============================================================================
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
PGDATABASE=silsilah_db
PGSSL=false

# ==============================================================================
# KREDENSIAL AKUN SUPERADMIN PERTAMA (Dibuat otomatis saat db:init)
# Ubah sesuai preferensi Anda sebelum menjalankan `npm run db:init`
# ==============================================================================
SUPERADMIN_USERNAME=silsilah
SUPERADMIN_PASSWORD=
SUPERADMIN_DISPLAY_NAME=Superadmin SILSILAH

# ==============================================================================
# KEAMANAN & SESI APLIKASI
# Buat string rahasia acak untuk pengamanan enkripsi sesi
# ==============================================================================
AUTH_SECRET=ganti_dengan_string_acak_rahasia_anda_minimal_32_karakter

# ==============================================================================
# NETWORK & BINDING (Opsional)
# 0.0.0.0 memungkinkan akses via IP lokal LAN / WiFi (misal: 192.168.x.x:3000)
# ==============================================================================
PORT=3000
HOSTNAME=0.0.0.0

# ==============================================================================
# INTEGRASI ASISTEN AI SILSILAH (Opsional: Google Gemini / OpenAI)
# Pengembang dapat menggunakan AI pilihan:
# 1. Google Gemini (Gratis di Google AI Studio: https://aistudio.google.com)
# 2. OpenAI / ChatGPT (https://platform.openai.com)
# Jika dikosongkan, sistem tetap berjalan dengan Mesin AI Lokal Cerdas bawaan.
# Sistem membaca database secara aman & terlindungi (Zero-leak: tanpa password/token).
# Nama Asisten AI (Bebas diubah sesuai keinginan)
AI_NAME=Asisten Silsilah

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ==============================================================================
# KONFIGURASI EMAIL SMTP (Untuk Mengirim Token Asli ke Email User Lupa Password)
# Masukkan email admin Anda (misal Gmail dengan App Password 16 karakter)
# Panduan Gmail: Aktifkan 2-Step Verification -> Buat 'App Password'
# ==============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="SILSILAH Keluarga <noreply@silsilah.local>"


